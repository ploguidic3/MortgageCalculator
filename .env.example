# AuditBoard
AUDITBOARD_BASE_URL=https://<your-tenant>.auditboardapp.com
AUDITBOARD_API_TOKEN=<bearer-token>
AUDITBOARD_POLICY_ENDPOINT=/v1/policies

# ServiceNow
SERVICENOW_INSTANCE=https://<your-instance>.service-now.com
SERVICENOW_AUTH_MODE=basic          # "basic" or "oauth"

# ServiceNow basic auth (SERVICENOW_AUTH_MODE=basic)
SERVICENOW_USER=<sn-username>
SERVICENOW_PASSWORD=<sn-password>

# ServiceNow OAuth (SERVICENOW_AUTH_MODE=oauth)
SERVICENOW_CLIENT_ID=<client-id>
SERVICENOW_CLIENT_SECRET=<client-secret>
SERVICENOW_TOKEN_URL=https://<your-instance>.service-now.com/oauth_token.do

# ServiceNow KB target
SERVICENOW_KB_SYS_ID=<knowledge-base-sys-id>
SERVICENOW_KB_CATEGORY=             # optional default category sys_id

# Sync behaviour
SYNC_AUTO_PUBLISH=true              # "true" => published, "false" => draft
SYNC_PAGE_SIZE=100
